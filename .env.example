# ─── Scenorya Community — configuration ─────────────────────────────────
# Copiez ce fichier en .env (ou saisissez ces variables dans Portainer).

# Version de l'image construite
SCENORYA_VERSION=0.3.0

# Adresse publique (utilisée pour les liens, e-mails et cookies sécurisés).
# En HTTPS derrière Nginx Proxy Manager : https://scenorya.mon-asso.fr
PUBLIC_URL=http://localhost:3000

# Secret principal : 32 caractères minimum, aléatoire, à conserver précieusement
# (il chiffre le mot de passe SMTP et l'IBAN). Générez-le avec :
#   openssl rand -base64 48
APP_SECRET=

# Base de données (PostgreSQL n'est jamais exposé hors du réseau Docker)
POSTGRES_USER=scenorya
POSTGRES_PASSWORD=
POSTGRES_DB=scenorya

# Jeton d'installation (facultatif). Vide : généré et affiché dans les
# journaux du conteneur au premier démarrage (docker logs scenorya).
SETUP_TOKEN=

# Exposition : par défaut sur 127.0.0.1 uniquement (accès via le proxy).
SCENORYA_BIND=127.0.0.1
SCENORYA_PORT=3000
# Réseau Docker partagé avec Nginx Proxy Manager
PROXY_NETWORK=npm_proxy

# Cookies « Secure » : auto = activés si PUBLIC_URL commence par https://
COOKIE_SECURE=auto
# Durée d'inactivité d'une session (heures)
SESSION_TTL_HOURS=12
# Nombre de sauvegardes conservées
BACKUP_RETENTION=14
