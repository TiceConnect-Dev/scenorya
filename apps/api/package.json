    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.12",
    "@node-rs/argon2": "^2.2.2",
    "@scenorya/shared": "0.9.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
